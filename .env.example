# ==============================================================================
# ReportSaathi Environment Configuration Template
# DO NOT commit the actual .env file with secrets into version control.
# Copy this file to .env and populate the values securely.
# ==============================================================================

# 1. Google Gemini API (Free tier from Google AI Studio)
# Required for Slice 2+ (Clinical AI summarization & Indic translation)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Telegram Bot Configuration (@BotFather)
# Required for Slice 4+ (Chat interface)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
WEBHOOK_SECRET=your_random_secure_webhook_secret_here

# 3. Supabase PostgreSQL Configuration
# Required for Task 1 (Database Health Check) and Slice 3+ (Persistence & Caching)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_secret_key_here

# 4. Deployment & Routing
# Backend service base URL (e.g. Render staging URL or local http://localhost:8000)
WEBHOOK_BASE_URL=https://reportsaathi-backend.onrender.com
# Allowed CORS origins for FastAPI (e.g. Cloudflare Pages URL or local http://localhost:5173)
CORS_ORIGIN=https://reportsaathi.pages.dev,http://localhost:5173

# 5. Local Development Paths
# Tesseract OCR executable path (Windows dev only; not needed on Linux/Render)
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
PORT=8000

# 6. Frontend Environment Variable (Vite)
# Point this to your local or deployed backend URL in frontend/.env
VITE_API_URL=http://localhost:8000
